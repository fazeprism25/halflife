# Halflife deployment environment: TEMPLATE. Copy the values you need into deploy/.env.
# `node deploy/setup.mjs` creates deploy/.env and generates the local secrets below for you.
# Never commit deploy/.env, and never paste keys into chats, issues or logs.
#
# The provider keys are held by the Bifrost gateway only. The rendered Bifrost config refers to
# them as `env.NAME` and never copies the value. The Halflife engine never sees them.

# --- provider credentials: fill in locally -------------------------------------------------
# Tavily (claim verification through the Bifrost "tavily" relay). https://app.tavily.com
TAVILY_API_KEY=
# DeepSeek (Bifrost's native "deepseek" provider -> https://api.deepseek.com, bearer auth).
# Create a key at https://platform.deepseek.com/api_keys. The account needs a positive balance:
# DeepSeek returns HTTP 402 "Insufficient Balance" otherwise.
DEEPSEEK_API_KEY=
# Other providers are optional. The first one present picks the default judge model, in this
# order: openai, deepseek, anthropic, gemini, groq, openrouter, mistral.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# --- model selection (optional; defaults are rendered from the keys present) ---------------
# Judge model for extraction, classification and verdicts. With DeepSeek the default is
# deepseek/deepseek-flash, called with thinking disabled (see ARCHITECTURE_DECISIONS AD-17).
# HALFLIFE_LLM_MODEL=deepseek/deepseek-flash
# Bifrost fallbacks, tried in order when the judge model errors.
# HALFLIFE_LLM_FALLBACKS=deepseek/deepseek-v4-pro
# Replaces the per-provider request fields for the judge (a JSON object). For example, to turn
# DeepSeek thinking back on at low effort:
# HALFLIFE_LLM_EXTRA_BODY={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# Models offered in the console playground (application traffic through the gateway).
# HALFLIFE_PLAYGROUND_MODELS=deepseek/deepseek-flash

# --- spend and behaviour (optional) ---------------------------------------------------------
# HALFLIFE_DAILY_CREDIT_CAP=150
# Tavily free-allowance guard (AD-19). The engine refuses paid calls beyond
# floor(plan_limit x fraction) of the ACCOUNT allowance (read from Tavily /usage via the relay),
# beyond its own lifetime total, or when usage is unreadable / pay-as-you-go usage appears.
# Raise the fraction (max 0.95) only to spend the reserve, e.g. for the final demo.
# HALFLIFE_TOTAL_CREDIT_CAP=700
# HALFLIFE_TAVILY_CEILING_FRACTION=0.8
# HALFLIFE_TAVILY_ACCOUNT_GUARD=1
# HALFLIFE_ENGINE_BUDGET_USD=2
# HALFLIFE_DEMO_BUDGET_USD=1
# HALFLIFE_CACHE_TTL_SECONDS=3600
# HALFLIFE_DEFAULT_MODE=async
# HALFLIFE_CONSOLE_TOKEN=
# HALFLIFE_OLLAMA_URL=http://host.docker.internal:11434

# --- generated local secrets (setup.mjs fills these; any random strings work) --------------
HALFLIFE_INGEST_TOKEN=
HALFLIFE_INTERNAL_TOKEN=
HALFLIFE_RELAY_TOKEN=
BIFROST_ADMIN_TOKEN=
HALFLIFE_ENGINE_VK=
HALFLIFE_DEMO_VK=
