# ---------------------------------------------------------------------------------------------
# Secrets: never commit. deploy/.env holds provider keys and generated local tokens.
# ---------------------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
*.pem
*.key
*.p12

# ---------------------------------------------------------------------------------------------
# Local runtime state: engine SQLite database and backups, Bifrost data
# ---------------------------------------------------------------------------------------------
engine/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------------------------
# Logs and machine-local generated output (regenerated by the scripts that write them)
# ---------------------------------------------------------------------------------------------
.build/
*.log
# integration/live-test results, the local Tavily/DeepSeek spend ledger and balance baseline
deploy/test/results/
# demo rehearsal transcripts (private)
deploy/demo/results/
# original, unredacted demo screenshots (private: they show local times and the time zone).
# Sanitised copies for documentation live in docs/assets/screenshots/.
deploy/demo/backup/
# hand-labelled v1/v2 raw runs (summaries eval/results/latest-v1.md and latest-v2.md are kept)
eval/results/run-*.json
# 2-item FreshQA smoke run, superseded by the full part-A run
eval/results/freshqa-A-2026-11-02T15-49-23-339Z.json

# ---------------------------------------------------------------------------------------------
# Third-party data and sources not redistributed by this repository
# ---------------------------------------------------------------------------------------------
# Full FreshQA snapshot exports: download them yourself (docs/EVALUATION.md). The FreshQA
# repository is Apache-2.0, but the spreadsheet data carries no explicit licence statement.
eval/data/freshqa/*.csv
# Files that reproduce FreshQA questions and answers verbatim, which carry the same unclear terms:
# the sampled set, the raw FreshQA runs and the per-item report. Rebuild them locally
# (docs/EVALUATION.md). eval/freshqa-adjudications.json holds only our own notes and is kept.
eval/freshqa-set.json
eval/results/freshqa-*.json
eval/results/latest-freshqa.md
# Bifrost source clones used only for reading during the feasibility sprint (~2.5 GB)
experiments/vendor/
experiments/feasibility/.run/
experiments/feasibility/build.log
experiments/feasibility/results/gateway-logs-last.txt
# host hardware/software inventory from the feasibility sprint (machine-specific)
experiments/feasibility/results/environment.json

# ---------------------------------------------------------------------------------------------
# Dependencies, build output, editor and OS files
# ---------------------------------------------------------------------------------------------
node_modules/
dist/
*.so
*.test
coverage/
.vscode/
.idea/
*.swp
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
